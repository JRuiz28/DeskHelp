@model List<DeskHelp.Models.TicketModel>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Título</th>
                <th>Fecha de creación</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>@ticket.Title</td>
                    <td>@ticket.CreatedIn.ToString("dd/MM/yyyy")</td>
                    <td>
                        @Html.ActionLink("Ver detalle", "Details", new { id = ticket.ID }, new { @class = "btn btn-info btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No se encontraron tickets.
    </div>
}