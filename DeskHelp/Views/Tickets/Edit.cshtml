@model DeskHelp.Models.TicketModel
@using DeskHelp.Models
@using System.Collections.Generic

@{
    ViewBag.Title = "Editar ticket";
}

<div class="text-center">
    <h1><strong>Editar ticket</strong></h1>

    <p class="text-muted">
        Modifica el ticket
    </p>

    <br />
</div>

@using (Html.BeginForm("Edit", "Tickets", FormMethod.Post))
{
    @Html.Hidden("ticketID", Model.ID);

    <div class="form-group">
        <label>Título:</label>
        <p class="form-control-static">@Model.Title</p>
    </div>

    <div class="form-group">
        <label>Estado:</label>

        @Html.DropDownList("stateID", new SelectList((List<StateTicketModel>)ViewBag.States, "ID", "Name", Model.StateID), new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Responsable o encargado:</label>

        @Html.DropDownListFor(model => model.AssignedUserID, (IEnumerable<SelectListItem>) new SelectList(ViewBag.Responsibles, "ID", "Name", Model.AssignedUserID),
            "-- Seleccione un responsable --",
            new { @class = "form-control" }
        )
    </div>

    <button type="submit" class="btn btn-primary">
        Actualizar datos
    </button>

    @Html.ActionLink("Cancelar", "Details", new { id = Model.ID }, new { @class = "btn btn-default" })
}