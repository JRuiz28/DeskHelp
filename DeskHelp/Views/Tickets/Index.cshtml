@model IEnumerable<DeskHelp.Models.TicketModel>
@using DeskHelp.Models
@using System.Linq

@{
    ViewBag.Title = "Mis tickets";
}


<div class="text-center">
    <h1><strong>Mis tickets</strong></h1>

    <p class="text-muted">
        Visualice sus tickets
    </p>

    <br />
</div>

<div>
    @Html.ActionLink("Crear nuevo ticket", "Create", "Tickets", null, new { @class = "btn btn-success pull-right" })
    <br /> <br />
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Título</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>@ticket.Title</td>
                    <td>
                        @(((List<StateTicketModel>)ViewBag.States).FirstOrDefault(s => s.ID == ticket.StateID)?.Name)
                    </td>
                    <td>
                        @Html.ActionLink("Ver detalle", "Details", new { id = ticket.ID }, new { @class = "btn btn-info btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No tienes tickets registrados.
    </div>
}