@model DeskHelp.Models.TicketModel
@using DeskHelp.Models
@using System.Linq
@using System.Collections.Generic
@using System.Web.Mvc
@{
    ViewBag.Title = "Detalle del ticket";
    var comments = ViewBag.Comments as List<CommentModel>;
    var currentUser = Session["User"] as UserModel;
}

@if (ViewBag.Success != null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.Success
    </div>
}

<div>
    @if (currentUser.Role == "Administrador")
    {
        <a href="@Url.Action("AdminIndex", "Tickets")" class="btn btn-primary" title="Regresar">
            <span class="glyphicon glyphicon-arrow-left"></span>
            Regresar
        </a>
    }
    else
    {
        <a href="@Url.Action("Index", "Tickets")" class="btn btn-primary" title="Regresar">
            <span class="glyphicon glyphicon-arrow-left"></span>
            Regresar
        </a>
    }
</div>
<br />

@if (currentUser.Role == "Administrador")
{
    <div>
        @Html.ActionLink("Editar ticket", "Edit", "Tickets", new { id = Model.ID }, new { @class = "btn btn-warning" })
    </div>
}


<div class="text-center">
    <h1><strong>@Model.Title</strong></h1>

    <p class="text-muted">
        Ticket
    </p>

    <br />
</div>

<div>
    <p><strong>Descripción:</strong></p>
    <p>@Model.Description</p>

    <p><strong>Categoría:</strong></p>
    <p> @Model.Category</p>

    <p>
        <strong>Estado:</strong>
        @(((List<StateTicketModel>)ViewBag.States).FirstOrDefault(s => s.ID == Model.StateID)?.Name)
    </p>

    <p><strong>Fecha de creación:</strong></p>
    <p> @Model.CreatedIn</p>
</div>


<hr />

<h3>Comentarios</h3>

@if (comments != null && comments.Count > 0)
{
    foreach (var comment in comments)
    {
        var isCurrentUser = comment.UserID == currentUser.ID;

        <div class="panel @(isCurrentUser ? "panel-primary" : "panel-default")">
            <div class="panel-heading">
                <strong>@comment.UserName</strong>
            </div>

            <div class="panel-body"> @comment.Text </div>

            <div class="panel-footer">
                Envíado el @comment.CreatedIn.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        Todavía no hay comentarios para este ticket.
    </div>
}

<hr />

<h3>Agregar comentario</h3>

@using (Html.BeginForm("AddComment", "Tickets", FormMethod.Post))
{
    @Html.Hidden("ticketID", Model.ID)

    <div class="form-group">
        <label for="text">Comentario:</label>

        <textarea name="text"
                  id="text"
                  class="form-control"
                  rows="4"
                  placeholder="Escribe tu comentario..."
                  required></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        <span class="glyphicon glyphicon-send"></span>
        Enviar comentario
    </button>
}